# Coach LLM: "anthropic" (Claude) or "openai" (any OpenAI-compatible API, incl. free local Ollama).
# See README "Choosing an LLM" for ready-made settings.
COACH_PROVIDER=anthropic
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5
# Only for COACH_PROVIDER=openai:
COACH_API_KEY=
COACH_BASE_URL=
COACH_EFFORT=medium
COACH_FALLBACKS=true
COACH_ONLY_MY_MOVES=true
STOCKFISH_PATH=/usr/games/stockfish
ENGINE_DEPTH=18
ENGINE_TIME=0.5
ENGINE_MULTIPV=3
ENGINE_DEEP_DEPTH=24
ENGINE_DEEP_TIME=3
ENGINE_THREADS=4
ENGINE_HASH_MB=256
MY_USERNAMES=your_username
PLAYER_RATING=1200
DATABASE_URL=sqlite:///./chess_coach.db
